# Copy to .env and adjust. docker compose reads .env automatically.

# Image to pull (published on GHCR for every v*.*.* tag). Pin a version for reproducible deployments.
IMAGE=ghcr.io/dreamyfishmt/fast-qwen-asr-inference-vllm
IMAGE_TAG=latest

# Host directory that contains the model folders (mounted read-only at /models).
# Windows (Docker Desktop): use forward slashes, e.g. D:/models
MODEL_DIR=/path/to/models

# Folder names inside MODEL_DIR
# Default: FP8 checkpoint vrfai/Qwen3-ASR-1.7B-fp8 (needs an RTX 30 series / SM80 or newer GPU).
# For the original BF16 model use ASR_MODEL_DIR=Qwen3-ASR-1.7B and an empty VLLM_QUANTIZATION.
ASR_MODEL_DIR=Qwen3-ASR-1.7B-fp8
VLLM_QUANTIZATION=modelopt
ALIGNER_MODEL_DIR=Qwen3-ForcedAligner-0.6B

# Forced aligner (timestamps for POST /transcribe?forced_alignment=true); not needed for streaming
ENABLE_ALIGNER_MODEL=false

# Optional shared secret for clients ("Authorization: Bearer <token>"); empty = no auth
API_TOKEN=

# Host port; the server is bound to localhost only
PORT=8907
BIND_ADDR=127.0.0.1

# Fraction of GPU memory vLLM may reserve
GPU_MEMORY_UTILIZATION=0.15

# Streaming: audio seconds per decode step. Smaller = faster partial updates, more GPU work.
STREAM_CHUNK_SIZE_SEC=1.0
STREAM_UNFIXED_CHUNK_NUM=2
STREAM_UNFIXED_TOKEN_NUM=5
PARTIAL_INTERVAL_MS=120

# Local build only (compose.local.yaml)
# CUDA base image: runtime (small) or devel (CUDA toolkit; required for BUNDLE_FLASH_ATTENTION=true)
CUDA_FLAVOR=runtime
# flash-attn only speeds up the forced aligner; compiling it can take a long time
BUNDLE_FLASH_ATTENTION=false
MAX_JOBS=8
