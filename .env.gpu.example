# NVIDIA GPU deployment with ONNX Runtime (compose.gpu.yaml). Copy to .env and adjust.
# Needs an NVIDIA driver with CUDA 13 support (R580+) and the NVIDIA Container Toolkit
# (Docker Desktop with the WSL 2 backend on Windows).

IMAGE=ghcr.io/dreamyfishmt/fast-qwen-asr-inference-vllm
IMAGE_TAG=latest-gpu

# Host directory that contains the model folder (mounted read-only at /models).
# Windows (Docker Desktop): use forward slashes, e.g. D:/models
MODEL_DIR=/srv/models
# Model folder from dreamyfishmt/qwen3-asr-1.7b-onnx (files of andrewleech/qwen3-asr-1.7b-onnx and
# sorryhyun/qwen3-asr-onnx-gqa, with an FP16 conversion of andrewleech's encoder).
# Download it with: scripts/download-models.sh 1.7b "$MODEL_DIR"  (see docs/deployment-gpu.md)
ASR_MODEL_DIR=qwen3-asr-1.7b-onnx
ONNX_DEVICE_ID=0

# Optional: word timestamps (forced aligner, ~1.3 GB more memory) and speaker diarization (~0.2 GB).
# Download with: scripts/download-models.sh aligner "$MODEL_DIR" / scripts/download-models.sh diarization "$MODEL_DIR"
ENABLE_ALIGNER_MODEL=false
ALIGNER_MODEL_DIR=qwen3-forcedaligner-0.6b-onnx
ENABLE_DIARIZATION=false
DIARIZATION_MODEL_DIR=speaker-diarization

# Optional shared secret ("Authorization: Bearer <token>"); required when the port is reachable from other machines
API_TOKEN=

# Host port. 127.0.0.1 = this machine only; 0.0.0.0 = LAN (set API_TOKEN), or keep 127.0.0.1 with the tls profile
PORT=8907
BIND_ADDR=127.0.0.1
# HTTPS/WSS via Caddy (--profile tls)
DOMAIN=

STREAM_PARTIALS=true
STREAM_PARTIAL_INTERVAL_SEC=1.0
STREAM_PARTIAL_MAX_SEC=60
STREAM_REUSE_PARTIAL=true
STREAM_FINAL_REUSE_PARTIAL=false
STREAM_MAX_SEC=120
