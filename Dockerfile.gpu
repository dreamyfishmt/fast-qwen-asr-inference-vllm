# Qwen3-ASR server on an NVIDIA GPU via ONNX Runtime (CUDA 13). No PyTorch, no vLLM.
# Built and started via compose.gpu.yaml; see docs/deployment-gpu.md.
# Needs an NVIDIA driver that supports CUDA 13 (R580 or newer) and the NVIDIA Container Toolkit.

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /usr/local/bin/uv

# Dependencies come from uv.lock (the `gpu` extra pins onnxruntime-gpu; see pyproject.toml).
# CUDA/cuDNN come as nvidia-* wheels (loaded by onnxruntime.preload_dlls()); the driver library
# (libcuda) is injected from the host by the NVIDIA Container Toolkit.
ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    uv sync --frozen --no-dev --no-install-project --extra gpu

RUN useradd --create-home --uid 1000 app
COPY server.py /app/server.py
COPY asr_server /app/asr_server

USER app
ENV ASR_BACKEND=onnx \
    ONNX_PROVIDER=cuda \
    MALLOC_ARENA_MAX=2
EXPOSE 8000

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
