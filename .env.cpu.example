# CPU deployment (compose.cpu.yaml). Copy to .env and adjust.

# Image to pull (published on GHCR for every v*.*.* tag with a -cpu suffix)
IMAGE=ghcr.io/dreamyfishmt/fast-qwen-asr-inference-vllm
IMAGE_TAG=latest-cpu

# Host directory that contains the model folder (mounted read-only at /models)
MODEL_DIR=/srv/models
# rhasspy/qwen3-asr-0.6b-onnx-int4-merged
ASR_MODEL_DIR=qwen3-asr-0.6b-onnx-int4-merged

# Shared secret for clients (required). Generate one with: openssl rand -hex 32
API_TOKEN=

# Plain HTTP/WS: clients use ws://<server-ip>:PORT/transcribe-streaming
PORT=8907
BIND_ADDR=0.0.0.0
# HTTPS/WSS (recommended on the public internet): set DOMAIN (DNS A record -> this server),
# set BIND_ADDR=127.0.0.1, and start with --profile tls. Clients use wss://DOMAIN/transcribe-streaming
DOMAIN=

# CPU threads for ONNX Runtime (0 = all cores)
ONNX_THREADS=0

# Live partial results re-transcribe the whole utterance so far, so they are limited to short utterances.
STREAM_PARTIALS=true
STREAM_PARTIAL_INTERVAL_SEC=2.0
STREAM_PARTIAL_MAX_SEC=10
# Audio beyond this length per utterance is dropped
STREAM_MAX_SEC=60
